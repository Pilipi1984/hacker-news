{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "TimeoutSeconds": 10,
    "Caching": {
      "IdsCacheSeconds": 60,
      "ItemCacheSeconds": 240,
      "MaxConcurrentUpstreamRequests": 10
    }
  },
  "BestStories": {
    "MaxN": 500
  }
}
